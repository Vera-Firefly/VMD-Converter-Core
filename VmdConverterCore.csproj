<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);CS8600;CS8601;CS8618;CS8625;CS8765</NoWarn>
    <AssemblyName>VmdConverterCore</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src/Program.cs" />
    <Compile Include="src/Executable/VmdAnimYamlWriter.cs" />
    <Compile Include="src/Executable/HpsBackendLoader.cs" />
    <Compile Include="src/Executable/PoseMemoryBudget.cs" />
    <Compile Include="src/Core/VmdHumanoidCurveSolver.cs" />
    <ProjectReference Include="src/Core/VmdConverterCore.Shared.csproj" />
    <ProjectReference Include="src/Modules/RootMotion/VmdConverterCore.RootMotion.csproj" />
    <ProjectReference Include="src/Modules/Muscles/VmdConverterCore.Muscles.csproj" />
  </ItemGroup>
  <Target Name="KeepNluModulesBesideExecutable" BeforeTargets="_ComputeFilesToBundle">
    <ItemGroup>
      <ResolvedFileToPublish Update="@(ResolvedFileToPublish)"
        Condition="'%(ResolvedFileToPublish.Filename)' == 'VmdConverterCore.RootMotion' Or '%(ResolvedFileToPublish.Filename)' == 'VmdConverterCore.Muscles' Or '%(ResolvedFileToPublish.Filename)' == 'VmdConverterCore.Shared'">
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
