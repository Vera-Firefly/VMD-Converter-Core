<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);CS8600;CS8601;CS8618;CS8625;CS8765</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>VmdConverterCore.Shared</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../UnityMathShim.cs" />
    <Compile Include="**/*.cs" Exclude="VmdHumanoidCurveSolver.cs;obj/**/*.cs;bin/**/*.cs" />
  </ItemGroup>
</Project>
